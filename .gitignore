__pycache__/
*.pyc
tools/
.env
.pytest_cache/
.cache/

# The generated corpus salt. Committing it would publish it, and a published salt is
# equivalent to no salt: `arg_key_hashes` becomes a wordlist lookup.
.sync-corpus-salt
.superpowers/
.import_linter_cache/

# Agent worktrees live inside .claude/ but are checkouts, not configuration.
# .claude/rules/ and .claude/skills/ are checked in deliberately.
.claude/worktrees/

# Coverage artifacts, written by the command docs/superpowers/specs/2026-07-29-sync-coverage-baseline.md publishes.
.coverage
coverage.json
