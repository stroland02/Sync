.venv/
__pycache__/
*.pyc
tools/
.env
.pytest_cache/
.cache/

# The generated corpus salt. Committing it would publish it, and a published salt is
# equivalent to no salt: `arg_key_hashes` becomes a wordlist lookup.
.sync-corpus-salt
.superpowers/
.import_linter_cache/

# Agent worktrees live inside .claude/ but are checkouts, not configuration.
# .claude/rules/ and .claude/skills/ are checked in deliberately.
.claude/worktrees/

# Coordination scratch handed to workers by path. Briefs go in a file rather than a dispatch
# message because long message bodies are truncated in delivery, and a worker whose tree is
# being written by someone else needs somewhere outside every worktree to park work.
# Untracked and unignored, these show up as `??` in every checkout and ride along on `git add -A`.
.claude/*-brief.txt
.claude/*-rulings.md
.claude/*-wip/

# Coverage artifacts, written by the command docs/superpowers/specs/2026-07-29-sync-coverage-baseline.md publishes.
.coverage
# `-n auto` puts coverage in parallel mode, and each worker writes its own
# `.coverage.<host>.<pid>.<random>` beside it. Ten of those were sitting untracked in a
# worktree when this line was added.
.coverage.*
coverage.json

# The corpus score, written by `scripts/score_corpus.py --json` and read by
# `scripts/gate_corpus.py`. A measurement of the tree it was taken on, so a committed copy is
# a number that goes stale silently while looking authoritative. The floors are what gets
# committed, in `gate_corpus.py`, beside the argument for each.
corpus-score.json

# The web console (M4). node_modules and the build output are reproducible from
# package-lock.json; the lockfile is committed, these are not.
web/node_modules/

# The root manifest `CI-W371` added for the npx doorbell means `npm` installs here too, and
# nothing ignored it. That is not merely untidy: `beta_gates.worktree_dirty()` counts untracked
# paths, so a lane that had ever run the doorbell reported a dirty worktree and Gate 4 refused
# to record a suite verdict for it -- correctly, and for a reason that was not the tree.
/node_modules/
web/dist/

# Ephemeral sweep state: when each budget notice was first seen. Per-machine, not shared.
scripts/orchestration/hold_clock.json
.sync-install.json

# Playwright MCP writes snapshots, console logs and screenshots beside the tree it drives.
# Verification output, never source -- and a screenshot committed by accident is a 200KB binary
# in a diff nobody can read.
.playwright-mcp/

# Screenshots the browser tools drop beside the tree when given a bare filename.
# `.playwright-mcp/` catches the snapshots and logs; this catches the images, which land
# in the repository root instead.
/*.png

# The Supabase reference capture: 356 screens, 126MB. Deliberately untracked -- twenty times the
# Stitch set, and unlike that one it is mined once rather than read per screen. What it teaches is
# tracked in docs/superpowers/references/notes/; the images stay local.
docs/supabase-reference/

