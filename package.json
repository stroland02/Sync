{
  "name": "@stroland02/sync-up",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Watches the third-party APIs a codebase calls and opens verified pull requests when one breaks. Docker if you have it; a user-space install if you do not.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sync-up": "bin/sync-up.mjs"
  },
  "scripts": {
    "start": "node bin/sync-up.mjs",
    "down": "node bin/sync-up.mjs down",
    "check": "node bin/sync-up.mjs --check",
    "install-docker": "node bin/sync-up.mjs --install-docker",
    "no-admin": "node bin/sync-up.mjs --no-admin",
    "dev": "uv run python scripts/dev_up.py"
  },
  "files": [
    "bin/",
    "docker-compose.demo.yml",
    "Dockerfile",
    "docker/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stroland02/Sync.git"
  }
}
