{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "tools": [
      {
        "name": "list_pages",
        "description": "Every page in one space.",
        "inputSchema": {
          "type": "object",
          "properties": ["space"],
          "required": ["space"]
        }
      },
      {
        "name": "rename_page",
        "description": "Renomme la page — accents délibérés.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "page_id": {
              "type": "string"
            },
            "title": true
          },
          "required": ["page_id"]
        }
      },
      {
        "name": "export_page",
        "description": "Export one page in a single format.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "format": {
              "anyOf": [
                {
                  "type": "string"
                }
              ]
            }
          },
          "required": ["format"]
        }
      },
      {
        "name": "archive_page",
        "description": "Archive one page.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "description": "Which pages this covers."
            }
          },
          "required": ["scope"]
        }
      }
    ]
  }
}
